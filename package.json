{
  "name": "shopflow-pro",
  "version": "4.0.0",
  "private": true,
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "description": "ShopFlow POS - Shop Management & Billing",
  "author": "ShopFlow",
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.19.2",
    "multer": "^2.0.2",
    "uuid": "^11.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.shopflow.pos",
    "productName": "ShopFlow POS",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "npmRebuild": false,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ShopFlow-POS-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}